{
  "name": "minute",
  "version": "0.1.0",
  "private": true,
  "description": "Slim handoff between non-tech stakeholders and engineering, in Slack and Discord.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "ci": "tsc --noEmit && npm test",
    "discord:commands": "tsx scripts/register-discord.ts",
    "playwright:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=22"

  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@octokit/rest": "^21.1.1",
    "@octokit/webhooks": "^13.8.0",
    "@slack/bolt": "^4.4.0",
    "@types/node": "^22.15.32",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "openai": "^5.8.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.53.0",
    "simple-git": "^3.28.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "yaml": "^2.8.0",
    "zod": "^3.25.67"
  }
}
