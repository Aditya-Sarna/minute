{
  "display_information": {
    "name": "Minute",
    "description": "Simple non-tech changes in chat. Photo in the thread. PR for tech.",
    "background_color": "#1a1a1a"
  },
  "features": {
    "bot_user": {
      "display_name": "Minute",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/minute",
        "description": "Ask for a simple change. Proof stays in this thread.",
        "usage_hint": "make the homepage background forest green"
      },
      {
        "command": "/minute-admin",
        "description": "Grant or revoke Minute access",
        "usage_hint": "allow @priya"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "commands",
        "files:read",
        "files:write",
        "channels:history",
        "groups:history",
        "im:history",
        "app_mentions:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
