# At least one LLM key is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MINUTE_LLM_MODEL=claude-sonnet-4-5-20250929

# GitHub — PAT or GitHub App installation token
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Slack (Socket Mode — no public URL needed)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_SIGNING_SECRET=

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=

# HTTP server for GitHub webhooks (optional; polling works without it)
PORT=8787
MINUTE_PUBLIC_URL=

# Path to yaml config (default: ./minute.config.yaml)
MINUTE_CONFIG=minute.config.yaml
