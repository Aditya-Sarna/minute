# At least one LLM key is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MINUTE_LLM_MODEL=claude-sonnet-4-5-20250929

# GitHub — PAT or GitHub App installation token (repo scope)
GITHUB_TOKEN=
# Recommended in production. Polling still works without it.
GITHUB_WEBHOOK_SECRET=

# Slack (Socket Mode — no public URL needed)
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-
SLACK_SIGNING_SECRET=

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=

PORT=8787
MINUTE_PUBLIC_URL=
MINUTE_CONFIG=minute.config.yaml
MINUTE_DATA_DIR=.data
MINUTE_MAX_JOBS=2
MINUTE_JOB_TIMEOUT_MS=480000
LOG_LEVEL=info
NODE_ENV=development
